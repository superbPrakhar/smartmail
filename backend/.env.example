# Google OAuth (for Gmail access — NOT for LLM)
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
CALLBACK_URL=http://localhost:5000/auth/callback
PORT=5000
FRONTEND_URL=http://localhost:5173
SESSION_SECRET=your_session_secret

# MongoDB (optional — uses file-based storage if not set)
# MONGODB_URI=mongodb://localhost:27017/smartmail

# Local AI (Ollama + Qwen3) — email summarization runs locally
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:1.7b
OLLAMA_TIMEOUT_MS=60000
OLLAMA_MAX_INPUT_CHARS=12000
