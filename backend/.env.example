# Google OAuth (for Gmail access — NOT for LLM)
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
CALLBACK_URL=http://localhost:5000/auth/callback
PORT=5000
FRONTEND_URL=http://localhost:5173
SESSION_SECRET=your_session_secret

# MongoDB (optional — uses file-based storage if not set)
# MONGODB_URI=mongodb://localhost:27017/smartmail

# Google Gemini AI Config (for email summarization)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash
